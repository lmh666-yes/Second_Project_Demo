{
  "version": 1,
  "note": "各脚本 --json 的**统一契约**。信封三键 tool/schema/ok 是每支都必须有的；再往后是各自的字段。校验器：检查/契约校验/json_contract.py（已挂进工具箱 --selftest 闸门）。改字段名前先改这里，否则闸门会红并点名。**script 是相对「工具箱」的路径**（检查/<名字>/xxx.py），校验器按工具箱根解析。",
  "envelope": {"tool": "str（脚本自报的工具名，见每条 entry 的 tool 字段）", "schema": "int（≥1）", "ok": "bool"},
  "tools": [
    {"script": "检查/进度跟踪/progress_scan.py", "tool": "progress_scan", "args": ["--json"],
     "keys": ["files", "markers", "stubs", "noop", "stub_files", "history", "root", "enc_stat"]},
    {"script": "检查/引脚规划/pin_planner.py", "tool": "pin_planner", "args": ["--json"],
     "keys": ["boards"]},
    {"script": "检查/RTOS检查/rtos_check.py", "tool": "rtos_check", "args": ["--json"],
     "keys": ["boards"]},
    {"script": "检查/编码守卫/encoding_guard.py", "tool": "encoding_guard", "args": ["--json"],
     "keys": ["scanned", "violations", "violations_list", "scan_roots", "eol_checked",
              "strict_comments", "comment_notes", "encoding_stat", "memory",
              "memory_missing", "ws_crlf_files", "ws_crlf_total"]},
    {"script": "检查/LoRa检查/lora_check.py", "tool": "lora_check", "args": ["--json"],
     "keys": ["boards", "cross"]},
    {"script": "检查/协议校验/protocol_check.py", "tool": "protocol_check", "args": ["--json"],
     "keys": ["boards", "findings"]},
    {"script": "检查/断网缓存/cache_check.py", "tool": "cache_check", "args": ["--json"],
     "keys": ["capacity_slots", "capacity_bytes", "slot_size", "payload", "period_ms",
              "replay_ms", "hold_seconds", "hold_text", "severe", "warn", "notes",
              "findings"]},
    {"script": "检查/链路仿真/chain_sim.py", "tool": "链路时序", "args": ["--json"],
     "keys": ["scenarios"]},
    {"script": "检查/协议对照/host_compare.py", "tool": "协议对照", "args": ["--json"],
     "keys": ["layer3", "host_stubs", "consts", "vectors"]},
    {"script": "检查/工程配置/config_audit.py", "tool": "工程配置", "args": ["--json"],
     "keys": ["audit", "inject"]},
    {"script": "检查/阶段判定/stage_status.py", "tool": "阶段判定", "args": ["--json"],
     "keys": ["rules", "boards", "applied"]},
    {"script": "检查/构建烧录/build_flash.py", "tool": "构建烧录", "args": ["--json"],
     "keys": ["boards"]},
    {"script": "检查/代码索引/code_index.py", "tool": "代码索引",
     "args": ["--index", "--board", "板1", "--json"],
     "keys": ["board", "calls"]},
    {"script": "检查/示例插件/check.py", "tool": "example_plugin", "args": ["--json"],
     "keys": ["files", "lines", "todo", "stub", "report"]}
  ],
  "excluded": [
    {"script": "检查/链路仿真/link_sim.py",
     "why": "没有 --json（它只造字节流；要看时序/断言走 chain_sim）"},
    {"script": "检查/报告/report_gen.py",
     "why": "没有 --json（它自己调别人的 --json 去攒 HTML，输出是文件不是数据）"},
    {"script": "检查/构建烧录/gen_selftest.py",
     "why": "没有 --json（生成 .c/.h，不给面板读）"},
    {"script": "程序/工程模板/project_scaffold.py",
     "why": "没有 --json（生成工程骨架，输出是文件）"},
    {"script": "检查/覆盖率/coverage_board.py",
     "why": "有 --json 但会**真跑全部脚本**（分钟级）——不进闸门；信封三键已补齐，它自己的 --selftest 守自己"},
    {"script": "检查/平台清单/platform_manifest.py",
     "why": "同上一档：有 --json 但会**真跑全部脚本**（分钟级）——不进闸门；B4 的清单页正靠这份数据，它自己的 --selftest 守自己"},
    {"script": "检查/脚手架/new_checker.py",
     "why": "没有 --json（它**生成**脚本，输出是文件 + 提示；生成的检查器各自带 --json 并由生成时自动登记）"},
    {"script": "检查/_plugin_host.py 与各检查目录的 check.py 壳",
     "why": "插件壳没有 --json（它们转发上游脚本的输出）"}
  ]
}
